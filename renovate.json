{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended", "customManagers:biomeVersions"],
	"automerge": true,
	"branchConcurrentLimit": 9,
	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": ["/(^|/)package\\.json$/"],
			"matchStrings": [
				"\"packageManager\":\\s*\"bun@(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
			],
			"depNameTemplate": "bun",
			"datasourceTemplate": "npm",
			"versioningTemplate": "npm"
		}
	],
	"internalChecksFilter": "strict",
	"minimumReleaseAge": "1 day",
	"prConcurrentLimit": 3,
	"prHourlyLimit": 9,
	"pruneBranchAfterAutomerge": true,
	"pruneStaleBranches": true,
	"statusCheckWhen": { "minimumReleaseAge": "never" },
	"packageRules": [
		{
			"description": "Temporary Bun 1.4.4 release-age exception; remove after 2026-10-23 10:20 UTC.",
			"matchPackageNames": ["bun", "oven-sh/bun", "@oven/bun-*", "bun-types"],
			"matchJsonata": ["version = '1.4.4' or newVersion = '1.4.4'"],
			"minimumReleaseAge": null
		},
		{
			"description": "Temporary exception for the current @types/bun release; remove with the Bun 1.4.4 exception.",
			"matchDatasources": ["npm"],
			"matchPackageNames": ["@types/bun"],
			"matchJsonata": ["version = '1.4.3' or newVersion = '1.4.3'"],
			"minimumReleaseAge": null
		},
		{
			"matchManagers": ["github-actions"],
			"dependencyDashboardApproval": true
		},
		{
			"matchPackageNames": ["@typescript/*"],
			"minimumReleaseAge": null
		},
		{
			"matchDatasources": ["npm"],
			"matchPackageNames": [
				"breakage",
				"comline",
				"jurist",
				"takua",
				"@correctlyjs/schemars",
				"correctly"
			],
			"minimumReleaseAge": null,
			"groupName": "jeremybanka packages"
		},
		{
			"matchPackageNames": ["wrangler", "@cloudflare/vitest-plugin"],
			"groupName": "Cloudflare Workers tooling"
		},
		{
			"matchPackageNames": ["bun", "oven-sh/bun"],
			"minimumReleaseAge": null,
			"groupName": "Bun"
		},
		{
			"description": "Keep the published compatibility data producer immutable. Add a new versioned dependency for another release instead of replacing this fixture.",
			"matchFileNames": [
				"packages/recoverage/__tests__/public/consumer/package.json"
			],
			"matchPackageNames": ["recoverage", "recoverage-0-1-18"],
			"enabled": false
		},
		{
			"matchPackageNames": ["dprint", "@dprint/*", "/^dprint-plugin-/"],
			"postUpgradeTasks": {
				"commands": [
					"bun install --frozen-lockfile",
					"bun run correctly schemas pull --association 'Dprint'"
				],
				"executionMode": "branch",
				"fileFilters": [".correctly/**"],
				"installTools": {
					"node": {},
					"bun": {}
				}
			}
		},
		{
			"matchPackageNames": [
				"renovatebot/github-action",
				"ghcr.io/renovatebot/renovate"
			],
			"postUpgradeTasks": {
				"commands": [
					"bun install --frozen-lockfile",
					"bun run correctly schemas pull --association 'Renovate'"
				],
				"executionMode": "branch",
				"fileFilters": [".correctly/**"],
				"installTools": {
					"node": {},
					"bun": {}
				}
			}
		},
		{
			"matchPackageNames": ["jdx/mise", "jdx/mise-action"],
			"postUpgradeTasks": {
				"commands": [
					"bun install --frozen-lockfile",
					"bun run correctly schemas pull --association 'Mise'"
				],
				"executionMode": "branch",
				"fileFilters": [".correctly/**"],
				"installTools": {
					"node": {},
					"bun": {}
				}
			}
		}
	]
}
