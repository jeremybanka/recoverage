{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended", "customManagers:biomeVersions"],
	"automerge": true,
	"branchConcurrentLimit": 9,
	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": ["/(^|/)package\\.json$/"],
			"matchStrings": [
				"\"packageManager\":\\s*\"bun@(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
			],
			"depNameTemplate": "bun",
			"datasourceTemplate": "npm",
			"versioningTemplate": "npm"
		}
	],
	"internalChecksFilter": "strict",
	"minimumReleaseAge": "1 day",
	"prConcurrentLimit": 3,
	"prHourlyLimit": 9,
	"pruneBranchAfterAutomerge": true,
	"pruneStaleBranches": true,
	"statusCheckWhen": { "minimumReleaseAge": "never" },
	"packageRules": [
		{
			"matchManagers": ["github-actions"],
			"dependencyDashboardApproval": true
		},
		{
			"matchPackageNames": ["@typescript/*"],
			"minimumReleaseAge": null
		},
		{
			"matchDatasources": ["npm"],
			"matchPackageNames": ["comline", "jurist", "takua"],
			"minimumReleaseAge": null,
			"groupName": "jeremybanka packages"
		},
		{
			"matchPackageNames": ["wrangler", "@cloudflare/vitest-pool-workers"],
			"groupName": "Cloudflare Workers tooling"
		},
		{
			"matchPackageNames": ["bun", "oven-sh/bun"],
			"minimumReleaseAge": null,
			"groupName": "Bun"
		},
		{
			"description": "Keep the published compatibility data producer immutable. Add a new alias for another release instead of replacing this fixture.",
			"matchFileNames": [
				"packages/recoverage/__tests__/public/consumer/package.json"
			],
			"matchPackageNames": ["recoverage", "recoverage-0-1-18"],
			"enabled": false
		}
	]
}
