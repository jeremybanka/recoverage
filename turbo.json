{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalDependencies": ["tsconfig.json", ".bun-version", ".node-version"],
	"tasks": {
		"build": {
			"dependsOn": ["gen", "^build", "^gen"],
			"outputs": ["dist/**", "**/dist/*", "**/dist/**/*", "bin/**"],
			"inputs": ["**/package.json", "src/**", "**/src/**", "tsdown.config.ts"]
		},
		"test:build": {
			"dependsOn": ["build"],
			"inputs": [
				"**/package.json",
				"src/**",
				"**/src/**",
				"__tests__/**",
				"__scripts__/**"
			]
		},
		"test": {
			"dependsOn": ["test:build", "^build"],
			"inputs": [
				"**/package.json",
				"src/**",
				"**/src/**",
				"__tests__/**",
				"__scripts__/**"
			]
		},
		"check:biome": {
			"cache": false
		},
		"check:eslint": {
			"dependsOn": ["gen"],
			"inputs": [
				"../../package.json",
				"../../eslint.config.ts",
				"**/package.json",
				"tsconfig.json",
				"src/**",
				"**/src/**",
				"__tests__/**",
				"__scripts__/**"
			]
		},
		"check:tsc": {
			"dependsOn": ["gen", "^check:tsc", "^build", "^gen"],
			"inputs": [
				"../../package.json",
				"../../tsconfig.json",
				"**/package.json",
				"tsconfig.json",
				"src/**",
				"**/src/**",
				"__tests__/**",
				"__scripts__/**"
			]
		},
		"watch:types": {
			"persistent": true,
			"dependsOn": ["gen", "^build", "^gen"],
			"inputs": [
				"../../package.json",
				"**/package.json",
				"tsconfig.json",
				"src/**",
				"**/src/**",
				"__tests__/**",
				"__scripts__/**"
			]
		},
		"check": {
			"dependsOn": ["check:biome", "check:eslint", "check:tsc"]
		},
		"gen": {
			"dependsOn": ["^build"],
			"outputs": ["**/*.gen.ts", "**/*.gen.tsx", "worker-configuration.d.ts"],
			"inputs": [
				"**/package.json",
				"tsconfig.json",
				"src/**",
				"**/src/**",
				"__tests__/**",
				"__scripts__/**"
			]
		},
		"test:watch": {
			"dependsOn": ["test:build", "^build"],
			"cache": false,
			"persistent": true
		}
	}
}
