{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "recoverage-cloud",
	"compatibility_date": "2025-02-24",
	"main": "src/index.tsx",
	"vars": {
		"STRIPE_MODE": "live",
		"REPORT_RATE_SCOPE": "recoverage-cloud",
		"CHECKOUT_ENABLED": "false"
	},
	"triggers": { "crons": ["0 3 * * *"] },
	"observability": {
		"logs": { "enabled": true }
	},
	// "compatibility_flags": ["nodejs_compat"],
	"ratelimits": [
		{
			"name": "REPORT_TOKEN_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 120, "period": 60 }
		},
		{
			"name": "REPORT_ACCOUNT_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 600, "period": 60 }
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "recoverage-data",
			"database_id": "48543dc9-b6d2-4546-93f0-d16f18495b8e",
			"migrations_dir": "drizzle"
		}
	]
}
