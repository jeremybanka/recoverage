{
	"extends": "../../tsconfig.json",
	"include": [
		"*.ts",
		"../__tests__/report-fixture.ts",
		"../src/billing-config.ts",
		"../src/stripe.ts"
	],
	"compilerOptions": {
		"composite": true,
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"lib": ["ESNext"],
		"types": ["bun"],
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx"
	}
}
