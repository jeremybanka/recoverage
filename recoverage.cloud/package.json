{
	"name": "recoverage.cloud",
	"type": "module",
	"private": true,
	"scripts": {
		"check": "pnpm run check:eslint && pnpm run check:tsc && pnpm run check:biome",
		"check:biome": "biome lint -- .",
		"check:eslint": "NODE_OPTIONS=--require=../scripts/eslint-typescript.cjs eslint -- .",
		"check:tsc": "pnpm run --parallel \"/^check:tsc:.*/\"",
		"check:tsc:main": "bun --check",
		"check:tsc:scripts": "bun --check --tsconfig-override __scripts__/tsconfig.json",
		"cov": "bun ../packages/recoverage/__scripts__/coverage.bun.ts",
		"cov:check": "pnpm run cov && bun ../packages/recoverage/__scripts__/coverage-check.bun.ts",
		"db:gen": "drizzle-kit generate",
		"db:up": "wrangler d1 migrations apply recoverage-data",
		"dev": "wrangler dev --live-reload",
		"gen": "pnpm run --parallel \"/^gen:.*/\"",
		"gen:scripts": "node __scripts__/gen-scripts.node.ts",
		"gen:types": "wrangler types",
		"go": "pnpm run --parallel \"/^setup:.*/\" && wrangler deploy --minify",
		"preview": "pnpm run --parallel \"/^preview:setup:.*/\" && wrangler deploy --minify --config wrangler-preview.jsonc",
		"preview:config": "node __scripts__/configure-preview.node.ts",
		"preview:d1": "node __scripts__/preview-d1.node.ts",
		"preview:d1:self-test": "node __scripts__/preview-d1.node.ts --self-test",
		"preview:setup:db": "wrangler d1 migrations apply \"$DATABASE_NAME\" --remote --config wrangler-preview.jsonc",
		"preview:setup:deps": "pnpm run setup:deps",
		"preview:setup:scripts": "pnpm run setup:scripts",
		"preview:teardown": "node __scripts__/preview-teardown.node.ts",
		"setup:db": "pnpm run db:up --remote",
		"setup:deps": "pnpm --filter recoverage run build",
		"setup:scripts": "node __scripts__/gen-scripts.node.ts",
		"setup:types": "wrangler types",
		"test": "vitest run",
		"test:watch": "vitest --watch",
		"watch:types": "tsc --watch --noEmit"
	},
	"dependencies": {
		"arktype": "2.2.8",
		"drizzle-orm": "0.45.4",
		"hono": "4.13.13",
		"htmx.org": "4.0.0",
		"istanbul-lib-coverage": "3.2.2",
		"jurist": "0.0.14",
		"nanoid": "6.0.2",
		"octokit": "5.0.5"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.4.6",
		"@hono/vite-build": "1.11.1",
		"@hono/vite-dev-server": "0.26.1",
		"@octokit/types": "18.0.0",
		"@t3-oss/env-core": "0.13.11",
		"@types/bun": "npm:bun-types@1.4.3",
		"@types/istanbul-lib-coverage": "2.0.6",
		"@types/node": "26.6.5",
		"cloudflare": "7.3.0",
		"drizzle-kit": "0.31.11",
		"eslint": "10.13.0",
		"fast-xml-parser": "5.11.2",
		"recoverage": "workspace:*",
		"recoverage-fixtures": "workspace:*",
		"takua": "0.2.3",
		"vite": "8.3.4",
		"vitest": "5.0.5",
		"wrangler": "4.151.3"
	}
}
