{
	"name": "recoverage.cloud",
	"type": "module",
	"private": true,
	"scripts": {
		"check": "bun run check:eslint && bun run check:tsc && bun run check:biome",
		"check:biome": "biome lint -- .",
		"check:eslint": "NODE_OPTIONS=--require=../scripts/eslint-typescript.cjs eslint -- .",
		"check:tsc": "concurrently \"bun:check:tsc:*\"",
		"check:tsc:main": "tsc --noEmit",
		"check:tsc:scripts": "tsc --noEmit --project __scripts__/tsconfig.json",
		"cov": "bun ../packages/recoverage/__scripts__/coverage.bun.ts",
		"cov:check": "bun run cov && bun ../packages/recoverage/__scripts__/coverage-check.bun.ts",
		"db:gen": "drizzle-kit generate",
		"db:up": "wrangler d1 migrations apply recoverage-data",
		"dev": "wrangler dev --live-reload",
		"gen": "concurrently \"bun:gen:*\"",
		"gen:scripts": "bun __scripts__/gen-scripts.bun.ts",
		"gen:types": "wrangler types",
		"go": "concurrently \"bun:setup:*\" && wrangler deploy --minify",
		"preview": "concurrently \"bun:preview:setup:*\" && wrangler deploy --minify --config wrangler-preview.jsonc",
		"preview:config": "bun __scripts__/configure-preview.bun.ts",
		"preview:d1": "bun __scripts__/preview-d1.bun.ts",
		"preview:d1:self-test": "bun __scripts__/preview-d1.bun.ts --self-test",
		"preview:setup:db": "wrangler d1 migrations apply \"$DATABASE_NAME\" --remote --config wrangler-preview.jsonc",
		"preview:setup:deps": "bun setup:deps",
		"preview:setup:scripts": "bun setup:scripts",
		"preview:teardown": "bun __scripts__/preview-teardown.bun.ts",
		"setup:db": "bun db:up --remote",
		"setup:deps": "bun run --filter=* build",
		"setup:scripts": "bun __scripts__/gen-scripts.bun.ts",
		"setup:types": "wrangler types",
		"test": "vitest run",
		"test:watch": "vitest --watch",
		"watch:types": "tsc --watch --noEmit"
	},
	"dependencies": {
		"arktype": "2.2.8",
		"drizzle-orm": "0.45.4",
		"hono": "4.13.13",
		"htmx.org": "4.0.0",
		"istanbul-lib-coverage": "3.2.2",
		"jurist": "0.0.14",
		"nanoid": "6.0.2",
		"octokit": "5.0.5"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.3.7",
		"@hono/vite-build": "1.11.1",
		"@hono/vite-dev-server": "0.26.1",
		"@octokit/types": "18.0.0",
		"@t3-oss/env-core": "0.13.11",
		"@types/bun": "npm:bun-types@1.4.2",
		"@types/istanbul-lib-coverage": "2.0.6",
		"@types/node": "26.6.4",
		"cloudflare": "7.3.0",
		"concurrently": "10.0.5",
		"drizzle-kit": "0.31.11",
		"eslint": "10.12.0",
		"fast-xml-parser": "5.11.2",
		"recoverage": "workspace:*",
		"recoverage-fixtures": "workspace:*",
		"takua": "0.2.3",
		"vite": "8.3.3",
		"vitest": "4.1.11",
		"wrangler": "4.148.0"
	}
}
