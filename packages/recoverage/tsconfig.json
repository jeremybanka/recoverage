{
	"extends": "../../tsconfig.json",
	"include": [
		"src",
		"__tests__/**/*.ts",
		"**/*.config.ts",
		"__scripts__/**/*.ts"
	],
	"exclude": ["dist", "__tests__/public/consumer"],
	"compilerOptions": {
		"allowJs": false,
		"declaration": true,
		"isolatedDeclarations": true,
		"types": ["vitest/globals"]
	}
}
